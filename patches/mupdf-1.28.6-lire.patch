+/* ---------------------------------------------------------------------------
+ * Lire : cache de glyphes de niveau 1, propre à chaque fz_context.
+ *
+ * Le cache partagé de MuPDF prend un verrou global (et modifie une liste LRU
+ * et un compteur de références partagés) pour CHAQUE glyphe dessiné : avec
+ * plusieurs threads de rendu sur une page riche en texte, ils passent leur
+ * temps à se disputer ce verrou (2 threads plus lents qu'un seul). Chaque
+ * thread ayant son propre contexte cloné, on garde ici une petite table à
+ * accès direct, consultée sans aucun verrou ; elle détient une référence sur
+ * le glyphe et sur la police (adresse jamais réutilisée tant qu'on la garde).
+ * ------------------------------------------------------------------------- */
+
+#define GLYPH_L1_SIZE 4096
+
+typedef struct
+{
+	fz_glyph_key key;
+	fz_glyph *val;
+} fz_glyph_l1_entry;
+
+typedef struct
+{
+	fz_glyph_l1_entry e[GLYPH_L1_SIZE];
+} fz_glyph_l1;
+
+void
+fz_drop_glyph_l1(fz_context *ctx)
+{
+	fz_glyph_l1 *l1;
+	int i;
+	if (!ctx || !ctx->glyph_l1)
+		return;
+	l1 = ctx->glyph_l1;
+	ctx->glyph_l1 = NULL;
+	for (i = 0; i < GLYPH_L1_SIZE; i++)
+		if (l1->e[i].val)
+		{
+			fz_drop_glyph(ctx, l1->e[i].val);
+			fz_drop_font(ctx, l1->e[i].key.font);
+		}
+	fz_free(ctx, l1);
+}
+
+fz_glyph *
+fz_render_glyph_borrow(fz_context *ctx, fz_font *font, int gid, fz_matrix *ctm, fz_colorspace *model, const fz_irect *scissor, int alpha, int aa, int *borrowed)
+{
+	fz_glyph_l1 *l1 = ctx->glyph_l1;
+	fz_glyph_l1_entry *slot;
+	fz_glyph_key key;
+	fz_matrix tmp = *ctm, subpix_ctm;
+	fz_glyph *val;
+	float size;
+	uint8_t t;
+	unsigned hash;
+
+	*borrowed = 0;
+	if (!l1)
+	{
+		l1 = fz_calloc_no_throw(ctx, 1, sizeof *l1);
+		if (!l1)
+			return fz_render_glyph(ctx, font, gid, ctm, model, scissor, alpha, aa);
+		ctx->glyph_l1 = l1;
+	}
+
+	/* même clé que fz_render_glyph (calculée sur une copie de la matrice) */
+	memset(&key, 0, sizeof key);
+	size = fz_subpixel_adjust(ctx, &tmp, &subpix_ctm, &key.e, &key.f);
+	t = (uint8_t)(model ? model->type : FZ_COLORSPACE_NONE);
+	if (size > MAX_GLYPH_SIZE || t == FZ_COLORSPACE_SEPARATION || t == FZ_COLORSPACE_INDEXED)
+		return fz_render_glyph(ctx, font, gid, ctm, model, scissor, alpha, aa);
+	key.font = font;
+	key.gid = gid;
+	key.a = subpix_ctm.a * 65536;
+	key.b = subpix_ctm.b * 65536;
+	key.c = subpix_ctm.c * 65536;
+	key.d = subpix_ctm.d * 65536;
+	key.aa = aa;
+	key.cs = t;
+	key.pad = 0;
+
+	hash = do_hash((unsigned char *)&key, sizeof(key));
+	slot = &l1->e[hash & (GLYPH_L1_SIZE - 1)];
+	if (slot->val && memcmp(&slot->key, &key, sizeof key) == 0)
+	{
+		*ctm = tmp;
+		*borrowed = 1;
+		return slot->val;
+	}
+
+	val = fz_render_glyph(ctx, font, gid, ctm, model, scissor, alpha, aa);
+	if (val)
+	{
+		if (slot->val)
+		{
+			fz_drop_glyph(ctx, slot->val);
+			fz_drop_font(ctx, slot->key.font);
+		}
+		slot->key = key;
+		slot->key.font = fz_keep_font(ctx, font);
+		slot->val = val;   /* la référence rendue par fz_render_glyph passe au cache L1 */
+		*borrowed = 1;
+	}
+	return val;
+}
