+/* ---------------------------------------------------------------------------
+ * Lire : tracé rapide des traits fins (« hairlines »).
+ *
+ * Un trait qui fait au plus HL_MAX pixel de large une fois à l'écran (soit la
+ * quasi-totalité des traits d'un plan dès qu'on n'est pas très zoomé) est tracé
+ * segment par segment avec une couverture calculée analytiquement, au lieu de
+ * passer par le convertisseur général (dont le coût croît comme le nombre
+ * d'arêtes du chemin entier multiplié par sa hauteur en sous-lignes).
+ * Rendu équivalent (même épaisseur minimale, lissage exact), 10 à 50 fois
+ * plus rapide sur les plans chargés.
+ * ------------------------------------------------------------------------- */
+
+#define HL_MAX 1.0f        /* traits fins : toute couleur, toute opacité */
+#define HL_WIDE_MAX 3.0f   /* traits moyens : couleur opaque seulement (jonctions par disques) */
+
+typedef struct
+{
+	fz_matrix ctm;
+	fz_pixmap *dest;
+	fz_irect clip;
+	float ex0, ey0, ex1, ey1;
+	const unsigned char *color;
+	int nc, da, a;
+	float w, hw, flat, cov;
+	const fz_stroke_state *stroke;
+	int dashing, didx, don, cap;
+	float dscale, period, dleft;
+	float sx, sy, cx, cy;
+	/* traits moyens (> 1 px) : jonctions et extrémités */
+	int wide, start_cap, end_cap, nseg;
+	float pdx, pdy, fdx, fdy;
+} hl_state;
+
+static inline void
+hl_plot(hl_state *h, int x, int y, float cov)
+{
+	unsigned char *p;
+	int k, i;
+	if (x < h->clip.x0 || x >= h->clip.x1 || y < h->clip.y0 || y >= h->clip.y1)
+		return;
+	k = (int)(cov * h->a + 0.5f);
+	if (k <= 0)
+		return;
+	if (k > 255)
+		k = 255;
+	p = h->dest->samples + (ptrdiff_t)(y - h->dest->y) * h->dest->stride + (ptrdiff_t)(x - h->dest->x) * h->dest->n;
+	for (i = 0; i < h->nc; i++)
+		p[i] = (unsigned char)((h->color[i] * k + p[i] * (255 - k) + 127) / 255);
+	if (h->da)
+		p[i] = (unsigned char)((255 * k + p[i] * (255 - k) + 127) / 255);
+}
+
+/* disque de rayon r (jonctions et bouts arrondis des traits moyens) */
+static void
+hl_disc(hl_state *h, float cx, float cy, float r)
+{
+	int i, j, i0, i1, j0, j1;
+	if (cx + r < h->ex0 || cx - r > h->ex1 || cy + r < h->ey0 || cy - r > h->ey1)
+		return;
+	i0 = (int)floorf(cx - r - 0.5f);
+	i1 = (int)floorf(cx + r + 0.5f);
+	j0 = (int)floorf(cy - r - 0.5f);
+	j1 = (int)floorf(cy + r + 0.5f);
+	for (j = j0; j <= j1; j++)
+		for (i = i0; i <= i1; i++)
+		{
+			float dx = i + 0.5f - cx, dy = j + 0.5f - cy;
+			float c = r + 0.5f - sqrtf(dx * dx + dy * dy);
+			if (c > 0)
+				hl_plot(h, i, j, c > 1 ? 1 : c);
+		}
+}
+
+/* segment (x0,y0)-(x1,y1) en pixels, déjà découpé à la zone utile */
+static void
+hl_span(hl_state *h, float x0, float y0, float x1, float y1, float cov)
+{
+	float dx = x1 - x0, dy = y1 - y0;
+	if (fabsf(dx) >= fabsf(dy))
+	{
+		float m, hh;
+		int i, ia, ib;
+		if (fabsf(dx) < 1e-6f)
+			return;
+		if (x0 > x1)
+		{
+			float t;
+			t = x0; x0 = x1; x1 = t;
+			t = y0; y0 = y1; y1 = t;
+		}
+		m = (y1 - y0) / (x1 - x0);
+		hh = h->hw * sqrtf(1 + m * m);
+		ia = (int)floorf(x0);
+		ib = (int)floorf(x1);
+		for (i = ia; i <= ib; i++)
+		{
+			float c0 = x0 > i ? x0 : (float)i;
+			float c1 = x1 < i + 1 ? x1 : (float)(i + 1);
+			float f = c1 - c0, yc, ya, yb;
+			int j, ja, jb;
+			if (f <= 0)
+				continue;
+			yc = y0 + m * ((c0 + c1) * 0.5f - x0);
+			ya = yc - hh;
+			yb = yc + hh;
+			ja = (int)floorf(ya);
+			jb = (int)floorf(yb);
+			f *= cov;
+			for (j = ja; j <= jb; j++)
+			{
+				float o = (yb < j + 1 ? yb : (float)(j + 1)) - (ya > j ? ya : (float)j);
+				if (o > 0)
+					hl_plot(h, i, j, o * f);
+			}
+		}
+	}
+	else
+	{
+		float m, hh;
+		int j, ja, jb;
+		if (y0 > y1)
+		{
+			float t;
+			t = x0; x0 = x1; x1 = t;
+			t = y0; y0 = y1; y1 = t;
+		}
+		m = (x1 - x0) / (y1 - y0);
+		hh = h->hw * sqrtf(1 + m * m);
+		ja = (int)floorf(y0);
+		jb = (int)floorf(y1);
+		for (j = ja; j <= jb; j++)
+		{
+			float c0 = y0 > j ? y0 : (float)j;
+			float c1 = y1 < j + 1 ? y1 : (float)(j + 1);
+			float f = c1 - c0, xc, xa, xb;
+			int i, ia, ib;
+			if (f <= 0)
+				continue;
+			xc = x0 + m * ((c0 + c1) * 0.5f - y0);
+			xa = xc - hh;
+			xb = xc + hh;
+			ia = (int)floorf(xa);
+			ib = (int)floorf(xb);
+			f *= cov;
+			for (i = ia; i <= ib; i++)
+			{
+				float o = (xb < i + 1 ? xb : (float)(i + 1)) - (xa > i ? xa : (float)i);
+				if (o > 0)
+					hl_plot(h, i, j, o * f);
+			}
+		}
+	}
+}
+
+/* découpage de Liang-Barsky contre la zone utile élargie ; 0 si invisible */
+static int
+hl_clip(hl_state *h, float x0, float y0, float x1, float y1, float *t0, float *t1)
+{
+	float dx = x1 - x0, dy = y1 - y0;
+	float p[4], q[4];
+	int k;
+	p[0] = -dx; q[0] = x0 - h->ex0;
+	p[1] = dx; q[1] = h->ex1 - x0;
+	p[2] = -dy; q[2] = y0 - h->ey0;
+	p[3] = dy; q[3] = h->ey1 - y0;
+	*t0 = 0;
+	*t1 = 1;
+	for (k = 0; k < 4; k++)
+	{
+		if (p[k] == 0)
+		{
+			if (q[k] < 0)
+				return 0;
+		}
+		else
+		{
+			float r = q[k] / p[k];
+			if (p[k] < 0)
+			{
+				if (r > *t1)
+					return 0;
+				if (r > *t0)
+					*t0 = r;
+			}
+			else
+			{
+				if (r < *t0)
+					return 0;
+				if (r < *t1)
+					*t1 = r;
+			}
+		}
+	}
+	return *t0 < *t1;
+}
+
+static void
+hl_line(hl_state *h, float x0, float y0, float x1, float y1)
+{
+	float t0, t1, dx = x1 - x0, dy = y1 - y0;
+	if (!hl_clip(h, x0, y0, x1, y1, &t0, &t1))
+		return;
+	hl_span(h, x0 + dx * t0, y0 + dy * t0, x0 + dx * t1, y0 + dy * t1, h->cov);
+}
+
+static void
+hl_dash_next(hl_state *h)
+{
+	h->didx = (h->didx + 1) % h->stroke->dash_len;
+	h->don = !h->don;
+	h->dleft = fabsf(h->stroke->dash_list[h->didx]) * h->dscale;
+}
+
+/* avance dans le motif de tirets sans rien tracer */
+static void
+hl_dash_skip(hl_state *h, float len)
+{
+	int guard = 0;
+	if (len > h->period)
+		len = fmodf(len, h->period);
+	while (len > 0 && guard++ < 4 * h->stroke->dash_len + 8)
+	{
+		if (len < h->dleft)
+		{
+			h->dleft -= len;
+			return;
+		}
+		len -= h->dleft;
+		hl_dash_next(h);
+	}
+}
+
+static void
+hl_dash_reset(hl_state *h)
+{
+	h->didx = 0;
+	h->don = 1;
+	h->dleft = fabsf(h->stroke->dash_list[0]) * h->dscale;
+	hl_dash_skip(h, fmodf(h->stroke->dash_phase * h->dscale, h->period));
+}
+
+static void
+hl_segment_raw(hl_state *h, float x0, float y0, float x1, float y1)
+{
+	float dx, dy, len, t0, t1, pos, end, ux, uy;
+	int guard = 0;
+	if (!h->dashing)
+	{
+		hl_line(h, x0, y0, x1, y1);
+		return;
+	}
+	dx = x1 - x0;
+	dy = y1 - y0;
+	len = sqrtf(dx * dx + dy * dy);
+	if (len <= 0)
+		return;
+	if (!hl_clip(h, x0, y0, x1, y1, &t0, &t1))
+	{
+		hl_dash_skip(h, len);
+		return;
+	}
+	ux = dx / len;
+	uy = dy / len;
+	pos = t0 * len;
+	end = t1 * len;
+	hl_dash_skip(h, pos);
+	while (pos < end && guard++ < 1000000)
+	{
+		float step = h->dleft < end - pos ? h->dleft : end - pos;
+		if (h->don)
+		{
+			if (step > 0)
+			{
+				hl_span(h, x0 + ux * pos, y0 + uy * pos, x0 + ux * (pos + step), y0 + uy * (pos + step), h->cov);
+				if (h->wide && h->cap != FZ_LINECAP_BUTT)
+				{
+					hl_disc(h, x0 + ux * pos, y0 + uy * pos, h->hw);
+					hl_disc(h, x0 + ux * (pos + step), y0 + uy * (pos + step), h->hw);
+				}
+			}
+			else if (h->cap != FZ_LINECAP_BUTT)
+			{
+				if (h->wide)
+					hl_disc(h, x0 + ux * pos, y0 + uy * pos, h->hw);
+				else
+					hl_span(h, x0 + ux * pos, y0 + uy * pos, x0 + ux * (pos + h->w), y0 + uy * (pos + h->w), h->cov);
+			}
+		}
+		pos += step;
+		h->dleft -= step;
+		if (h->dleft <= 0)
+			hl_dash_next(h);
+	}
+	hl_dash_skip(h, len - end);
+}
+
+/* angle marqué entre deux directions -> jonction visible sur un trait moyen */
+static int
+hl_sharp(float ax, float ay, float bx, float by)
+{
+	float la = ax * ax + ay * ay, lb = bx * bx + by * by, d = ax * bx + ay * by;
+	if (la <= 0 || lb <= 0)
+		return 0;
+	return d < 0.94f * sqrtf(la * lb);   /* plus de ~20° */
+}
+
+static void
+hl_segment(hl_state *h, float x0, float y0, float x1, float y1)
+{
+	if (h->wide && !h->dashing)
+	{
+		float dx = x1 - x0, dy = y1 - y0;
+		if (dx * dx + dy * dy < 1e-12f)
+			return;
+		if (h->nseg == 0)
+		{
+			h->fdx = dx;
+			h->fdy = dy;
+			if (h->start_cap != FZ_LINECAP_BUTT)
+				hl_disc(h, x0, y0, h->hw);
+		}
+		else if (hl_sharp(h->pdx, h->pdy, dx, dy))
+			hl_disc(h, x0, y0, h->hw);
+		h->pdx = dx;
+		h->pdy = dy;
+		h->nseg++;
+	}
+	hl_segment_raw(h, x0, y0, x1, y1);
+}
+
+/* fin d'un sous-chemin ouvert : bout arrondi / carré */
+static void
+hl_end_subpath(hl_state *h)
+{
+	if (h->wide && !h->dashing && h->nseg > 0 && h->end_cap != FZ_LINECAP_BUTT)
+		hl_disc(h, h->cx, h->cy, h->hw);
+	h->nseg = 0;
+}
+
+static void
+hl_moveto(fz_context *ctx, void *arg, float x, float y)
+{
+	hl_state *h = arg;
+	fz_point p = fz_transform_point_xy(x, y, h->ctm);
+	hl_end_subpath(h);
+	h->sx = h->cx = p.x;
+	h->sy = h->cy = p.y;
+	if (h->dashing)
+		hl_dash_reset(h);
+}
+
+static void
+hl_lineto(fz_context *ctx, void *arg, float x, float y)
+{
+	hl_state *h = arg;
+	fz_point p = fz_transform_point_xy(x, y, h->ctm);
+	hl_segment(h, h->cx, h->cy, p.x, p.y);
+	h->cx = p.x;
+	h->cy = p.y;
+}
+
+static void
+hl_curveto(fz_context *ctx, void *arg, float x1, float y1, float x2, float y2, float x3, float y3)
+{
+	hl_state *h = arg;
+	fz_point p0 = { h->cx, h->cy };
+	fz_point p1 = fz_transform_point_xy(x1, y1, h->ctm);
+	fz_point p2 = fz_transform_point_xy(x2, y2, h->ctm);
+	fz_point p3 = fz_transform_point_xy(x3, y3, h->ctm);
+	float bx0 = fminf(fminf(p0.x, p1.x), fminf(p2.x, p3.x)), bx1 = fmaxf(fmaxf(p0.x, p1.x), fmaxf(p2.x, p3.x));
+	float by0 = fminf(fminf(p0.y, p1.y), fminf(p2.y, p3.y)), by1 = fmaxf(fmaxf(p0.y, p1.y), fmaxf(p2.y, p3.y));
+	h->cx = p3.x;
+	h->cy = p3.y;
+	if (bx1 < h->ex0 || bx0 > h->ex1 || by1 < h->ey0 || by0 > h->ey1)
+	{
+		/* courbe hors de la zone : on ne fait qu'avancer les tirets (longueur approchée) */
+		if (h->dashing)
+		{
+			float l = hypotf(p1.x - p0.x, p1.y - p0.y) + hypotf(p2.x - p1.x, p2.y - p1.y) + hypotf(p3.x - p2.x, p3.y - p2.y);
+			float c = hypotf(p3.x - p0.x, p3.y - p0.y);
+			hl_dash_skip(h, (l + c) * 0.5f);
+		}
+		return;
+	}
+	{
+		float ddx = fmaxf(fabsf(p0.x - 2 * p1.x + p2.x), fabsf(p1.x - 2 * p2.x + p3.x));
+		float ddy = fmaxf(fabsf(p0.y - 2 * p1.y + p2.y), fabsf(p1.y - 2 * p2.y + p3.y));
+		float dd = sqrtf(ddx * ddx + ddy * ddy);
+		int n = (int)ceilf(sqrtf(0.75f * dd / h->flat)), k;
+		float px = p0.x, py = p0.y;
+		if (n < 1)
+			n = 1;
+		if (n > 256)
+			n = 256;
+		for (k = 1; k <= n; k++)
+		{
+			float t = (float)k / n, u = 1 - t;
+			float a = u * u * u, b = 3 * u * u * t, c = 3 * u * t * t, d = t * t * t;
+			float qx = a * p0.x + b * p1.x + c * p2.x + d * p3.x;
+			float qy = a * p0.y + b * p1.y + c * p2.y + d * p3.y;
+			if (k == n)
+			{
+				qx = p3.x;
+				qy = p3.y;
+			}
+			hl_segment(h, px, py, qx, qy);
+			px = qx;
+			py = qy;
+		}
+	}
+}
+
+static void
+hl_closepath(fz_context *ctx, void *arg)
+{
+	hl_state *h = arg;
+	hl_segment(h, h->cx, h->cy, h->sx, h->sy);
+	if (h->wide && !h->dashing && h->nseg > 1 && hl_sharp(h->pdx, h->pdy, h->fdx, h->fdy))
+		hl_disc(h, h->sx, h->sy, h->hw);
+	h->cx = h->sx;
+	h->cy = h->sy;
+	h->nseg = 0;
+}
+
+static const fz_path_walker hl_walker =
+{
+	hl_moveto,
+	hl_lineto,
+	hl_curveto,
+	hl_closepath,
+	NULL, NULL, NULL, NULL
+};
+
+/* LIRE_NOHL=1 dans l'environnement : désactive le tracé rapide (comparaisons) */
+static int
+hl_disabled(void)
+{
+	static int v = -1;
+	if (v < 0)
+		v = getenv("LIRE_NOHL") != NULL;
+	return v;
+}
+
+static void
+hairline_stroke(fz_context *ctx, fz_pixmap *dest, fz_irect clip, const fz_path *path, const fz_stroke_state *stroke,
+	fz_matrix ctm, float expansion, float width, const unsigned char *colorbv)
+{
+	hl_state h;
+	if (fz_is_empty_irect(clip))
+		return;
+	memset(&h, 0, sizeof h);
+	h.ctm = ctm;
+	h.dest = dest;
+	h.clip = clip;
+	h.ex0 = clip.x0 - 2.0f - width;
+	h.ey0 = clip.y0 - 2.0f - width;
+	h.ex1 = clip.x1 + 2.0f + width;
+	h.ey1 = clip.y1 + 2.0f + width;
+	h.nc = dest->n - dest->alpha;
+	h.da = dest->alpha;
+	h.color = colorbv;
+	h.a = colorbv[h.nc];
+	h.w = width;
+	h.hw = width * 0.5f;
+	h.flat = 0.3f;
+	h.cov = 1;
+	h.stroke = stroke;
+	h.cap = stroke->dash_cap;
+	h.wide = width > 1.0f;
+	h.start_cap = stroke->start_cap;
+	h.end_cap = stroke->end_cap;
+	if (stroke->dash_len > 0)
+	{
+		float sum = 0, on = 0;
+		int i, k, n = stroke->dash_len * ((stroke->dash_len & 1) ? 2 : 1);
+		for (i = 0; i < n; i++)
+		{
+			float v = fabsf(stroke->dash_list[i % stroke->dash_len]);
+			sum += v;
+			if (!(i & 1))
+			{
+				on += v;
+				if (h.cap != FZ_LINECAP_BUTT)
+					on += width / expansion;
+			}
+		}
+		k = sum * expansion >= 1.0f;
+		if (sum <= 0)
+			h.cov = 1;
+		else if (!k)
+			h.cov = on / sum < 1 ? on / sum : 1;   /* motif plus fin qu'un pixel : teinte moyenne */
+		else
+		{
+			h.dashing = 1;
+			h.dscale = expansion;
+			h.period = sum * expansion;
+		}
+	}
+	fz_walk_path(ctx, path, &hl_walker, &h);
+	hl_end_subpath(&h);
+}
